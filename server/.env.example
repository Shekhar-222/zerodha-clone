KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# Where Kite should redirect after login (must match the redirect URL configured on developers.kite.trade)
KITE_REDIRECT_URL=http://localhost:4000/api/auth/callback

# After a successful login, backend redirects the browser here (the frontend dev server)
CLIENT_URL=http://localhost:5173

PORT=4000

# Starting virtual cash balance for the paper trading account
VIRTUAL_CAPITAL=2000000

# Optional: enables automatic daily re-login by headlessly driving Kite's own login page.
# Leave unset to keep using the manual /api/auth/login flow instead.
# NOTE: automating Kite's login page is outside Kite Connect's intended API usage — use at
# your own discretion, for your own personal account only.
KITE_USER_ID=
KITE_PASSWORD=
KITE_PIN=
